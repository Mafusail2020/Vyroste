# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Origins
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000

# WayForPay — optional; /api/payments/checkout returns 503 if not set
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_KEY=
WAYFORPAY_MERCHANT_DOMAIN=vyroste.ua

# SendPulse SMTP — optional; GDD email alerts are skipped if not set
SENDPULSE_SMTP_HOST=smtp.sendpulse.com
SENDPULSE_SMTP_PORT=587
SENDPULSE_SMTP_USER=
SENDPULSE_SMTP_PASS=
FROM_EMAIL=hello@vyroste.ua
